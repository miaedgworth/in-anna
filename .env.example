# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string — used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth — the single admin account
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
ADMIN_EMAIL="hello@inannaboutique.co.uk"
# Generate with: npm run hash -- "your-password"
# IMPORTANT: in a .env file every $ must be escaped as \$ — Next.js expands
# $VAR references and would otherwise eat most of the hash. Paste the
# UNescaped hash into the Vercel dashboard; no expansion happens there.
ADMIN_PASSWORD_HASH="\$2b\$12\$replace.this.with.a.real.bcrypt.hash.value.exactly.as.printed"

# ---------------------------------------------------------------------------
# Image uploads
# ---------------------------------------------------------------------------
# Vercel Blob read/write token. Leave empty in local development and uploads
# fall back to writing into /public/uploads.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.inannaboutique.co.uk"
